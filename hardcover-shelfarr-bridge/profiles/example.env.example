# Copy this to profiles/<name>.env (e.g. profiles/tracy.env) — one file per Hardcover user.
# Each profile is self-contained: it needs THAT user's own two tokens. Everything else is
# optional and falls back to the bridge's built-in defaults.
#
# Runs on its own state file (data/state.<name>.json) so users never clobber each other.
#   node scripts/bridge.mjs --profile <name>            # run just this user
#   node scripts/bridge.mjs --profile <name> --dry-run  # preview
#   node scripts/run-all.mjs                            # run every user

# The user's Hardcover personal access token (hardcover.app/account/api, their own account).
HARDCOVER_API_TOKEN=hc_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# A scoped Shelfarr API token from THIS user's Shelfarr account (Profile -> API tokens,
# scopes: Search + Read requests + Create/cancel requests). This is what attributes the
# requests to them in Shelfarr.
SHELFARR_API_TOKEN=shf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- optional overrides (defaults shown) ---
# SHELFARR_URL=http://192.168.1.56:5056
# BOOK_TYPES=ebook              # comma-separated, e.g. ebook,audiobook
# MIN_CONFIDENCE=50
# MAX_REQUESTS_PER_RUN=15
# REQUEST_DELAY_MS=2000
# SEARCH_DELAY_MS=1200
