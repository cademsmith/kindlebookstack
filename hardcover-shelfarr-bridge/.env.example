# Hardcover personal API token — hardcover.app/account/api
HARDCOVER_API_TOKEN=hc_pat_CHANGE_ME

# Shelfarr instance + a scoped API token (Shelfarr: Profile -> API tokens)
# Scopes needed: search:read, requests:write
SHELFARR_URL=http://192.168.1.56:5056
SHELFARR_API_TOKEN=shf_CHANGE_ME

# Which book type(s) to request, comma-separated (ebook, audiobook)
BOOK_TYPES=ebook

# Minimum Shelfarr search confidence (0-100) to accept a title-only match
MIN_CONFIDENCE=50

# Cap on how many NEW requests one run will create (protects your download client
# from a big Want to Read shelf all landing at once). Extras roll to the next run.
MAX_REQUESTS_PER_RUN=15

# Pause between live requests, in milliseconds
REQUEST_DELAY_MS=2000
