# Shelfarr config — copy to `.env` and fill in.
# In Portainer, put these into the stack's "Environment variables" section instead of a file.

SHELFARR_IMAGE=ghcr.io/pedro-revez-silva/shelfarr:latest
SHELFARR_PORT=5056       # change if 5056 is already in use on your host
TZ=America/New_York
PUID=1000
PGID=1000

# --- Host paths (use ABSOLUTE paths on a NAS/Portainer) ---
SHELFARR_DATA_HOST_PATH=/portainer/Files/AppData/Config/Shelfarr
# Point these at the SAME folders BookOrbit's library reads from, so anything
# Shelfarr downloads shows up in BookOrbit automatically.
EBOOKS_HOST_PATH=/media/HDD/data/BookOrbit/books/ebooks
AUDIOBOOKS_HOST_PATH=/media/HDD/data/BookOrbit/books/audiobooks
# Wherever your torrent client (Transmission, qBittorrent, etc.) writes completed downloads.
DOWNLOADS_HOST_PATH=/media/HDD/data/torrents

# --- Post-deploy setup (done once, in the Shelfarr UI — not env vars) ---
# 1. Admin -> Settings -> Download Clients: add your client (e.g. Transmission),
#    set its download path to /downloads, pick a category (e.g. "shelfarr").
# 2. Admin -> Settings -> Search: set Provider = Prowlarr, enter its URL + API key.
#    (Optional extras: Anna's Archive + Flaresolverr, LibriVox, Project Gutenberg.)
# 3. Admin -> Settings -> Downloads: Download Remote Path = /downloads (or
#    /downloads/<category> if your client nests by category), Local Path = /downloads,
#    Ebook Output = /ebooks, Audiobook Output = /audiobooks.
# 4. Admin -> Settings -> Integrations: Library Platform = BookOrbit, its URL, and
#    a BookOrbit account's username/password (so Shelfarr can trigger library scans).
#
# GOTCHA: redeploying/recreating this stack wipes the settings from steps 1-4
# (admin login + library data survive) — avoid unnecessary redeploys, and if one
# happens, just redo steps 1-4 in the UI.
