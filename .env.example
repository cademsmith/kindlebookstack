# BookOrbit config — copy to `.env` and fill in.
# In Portainer, put these into the stack's "Environment variables" section instead of a file.

APP_IMAGE=ghcr.io/bookorbit/bookorbit:latest
APP_PORT=3000            # change if 3000 is already in use on your host
TZ=America/New_York
PUID=1000
PGID=1000

# --- Host paths (use ABSOLUTE paths on a NAS/Portainer) ---
BOOKS_HOST_PATH=/media/HDD/data/BookOrbit/books
APP_DATA_HOST_PATH=/media/HDD/data/BookOrbit/app
DB_DATA_HOST_PATH=/media/HDD/data/BookOrbit/postgres

# External URL used for links / Send-to-Kindle / Kobo endpoints
APP_URL=http://192.168.1.56:3000

# --- Database ---
POSTGRES_USER=bookorbit
POSTGRES_DB=bookorbit
POSTGRES_PASSWORD=CHANGE_ME            # e.g. openssl rand -base64 24

# --- Secrets: generate each with `openssl rand -hex 32` ---
JWT_SECRET=CHANGE_ME
SETUP_BOOTSTRAP_TOKEN=CHANGE_ME        # used once to create the first admin

NODE_MAX_OLD_SPACE_SIZE=2048
